# Copy this file to .env and fill in real values. Never commit .env.

# MongoDB Atlas connection string (Atlas → Database → Connect → Drivers).
# Include the database name after the host, e.g. /ipl_team_updates
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/ipl_team_updates?retryWrites=true&w=majority

# Express API port
PORT=5000

# Origin allowed by CORS (Vite dev server locally; the nginx container is same-origin)
CLIENT_URL=https://ipl-team-updates-realtime-notificat.vercel.app

# JWT signing secret (required). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ---------- Admin account (optional) ----------
# Created (or an existing user with that username/email promoted, password unchanged) when
# the server starts. Log in at /admin/login; admins use /admin/dashboard and /api/admin/*.
# Use your own password (min 8 chars); the example value below is refused.
# ADMIN_EMAIL is optional (defaults to <username>@admin.local).
# Leave these empty to skip, and promote users later with: npm run make-admin -- <username|email>
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-password
ADMIN_NAME=Admin
ADMIN_EMAIL=

# ---------- Frontend (optional, build-time) ----------
# The client calls the API at /api and the WebSocket at /api/ws on its own origin; Vite (dev)
# and nginx (Docker) proxy both to the server, so no URLs are needed. Set these only to point
# a build at another server. Only VITE_* values reach the browser — never put secrets here.
# VITE_API_URL=https://ipl-team-updates-realtime-notification.onrender.com   (backend origin; /api is appended)
# (client/.env.production already sets this for `npm run build`; the WS URL is derived as wss://<host>/api/ws)
# VITE_WS_URL=wss://ipl-team-updates-realtime-notification.onrender.com/api/ws   (optional override)

# ---------- Live score match simulator ----------
# Set to false to turn the automatic match loop off (admins can still start matches).
SIMULATOR_ENABLED=true
# Overs per innings (1-50) and pace of the simulation.
SIM_OVERS=20
SIM_BALL_INTERVAL_MS=3000
SIM_INNINGS_BREAK_MS=15000
SIM_MATCH_BREAK_MS=60000
# true = a finished match updates the teams' wins/losses/points in MongoDB, which
# triggers Change Stream notifications for followers. Off by default.
SIM_UPDATE_STANDINGS=false
